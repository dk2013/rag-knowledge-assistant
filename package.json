{
  "name": "rag-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "RAG knowledge assistant: answers questions from your documents with source citations (Next.js + Node.js + PostgreSQL/pgvector + Ollama/OpenAI)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc --noEmit",
    "ask": "tsx scripts/ask.ts",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "next": "^15.5.29",
    "pg": "^8.16.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "unpdf": "^1.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.8",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33",
      "sharp": "^0.35.5"
    }
  },
  "license": "MIT"
}
