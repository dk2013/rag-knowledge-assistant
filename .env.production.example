# Copy to .env.production on the server and fill in the blanks. Never commit the real file.

# Database password for the demo's own Postgres container (any long random string)
POSTGRES_PASSWORD=

# Port on 127.0.0.1 that nginx proxies to
APP_PORT=3100

# Models: OpenAI for chat and embeddings (768 dimensions to match the schema)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768
TOP_K=6

# Public demo protection
DEMO_MODE=true
RATE_LIMIT_PER_IP=20
DAILY_QUESTION_LIMIT=300
REPO_URL=https://github.com/dk2013/rag-knowledge-assistant
