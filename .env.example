# PostgreSQL with pgvector (see docker-compose.yml)
DATABASE_URL=postgres://rag:rag@localhost:5433/rag

# Which provider answers questions and creates embeddings: "ollama" (local, free) or "openai"
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Ollama (local models)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# OpenAI (optional). With text-embedding-3-small we request 768 dimensions to match the schema.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector size must match the embedding model (nomic-embed-text = 768)
EMBEDDING_DIM=768

# How many chunks go into the prompt
TOP_K=6

# Public demo protection (leave off for local use)
# DEMO_MODE=true makes the knowledge base read-only (no uploads or deletes)
DEMO_MODE=false
# Max questions per visitor IP per hour, and per day for the whole site (0 = no limit)
RATE_LIMIT_PER_IP=0
DAILY_QUESTION_LIMIT=0
# Link shown in the demo banner
REPO_URL=
